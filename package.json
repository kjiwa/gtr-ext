{
  "name": "gtr-ext",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "kjiwa/gtr-ext",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "lint": "eslint --max-warnings=0 . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "pkg": "rm -f gtr-ext-*.zip && NODE_ENV=production npm run build && cd dist && zip -qrX \"../gtr-ext-$(node -p \"require(\\\"../static/manifest.json\\\").version\").zip\" .",
    "lint:ext": "addons-linter dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "addons-linter": "^10.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
