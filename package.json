{
  "name": "gtr-ext",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "kjiwa/gtr-ext",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "lint": "eslint --max-warnings=0 . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "pkg": "npm run build && cd dist && zip -qr ../gtr-ext.zip .",
    "lint:ext": "web-ext lint -s dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11",
    "web-ext": "^10.7.0"
  }
}
