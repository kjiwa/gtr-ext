{
  "manifest_version": 3,
  "name": "Gargantuan Takeout Rocket",
  "version": "1.1.0",
  "author": "kjiwa",
  "description": "Copies Google Takeout archives to Azure Blob Storage through your own Cloudflare Worker.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "gtr-ext@kjiwa.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["downloads", "cookies", "storage", "notifications"],
  "host_permissions": ["https://*.google.com/*", "https://*.googleusercontent.com/*", "https://storage.googleapis.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {
    "192": "logo192.png",
    "512": "logo512.png"
  },
  "action": {
    "default_icon": {
      "192": "logo192.png",
      "512": "logo512.png"
    },
    "default_title": "Takeout Rocket",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
